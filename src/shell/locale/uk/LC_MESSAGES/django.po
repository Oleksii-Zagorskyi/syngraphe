msgid "a table row wider than its header"
msgstr "рядок таблиці, ширший за рядок заголовків"

#: editing/messages.py:28
msgid "an image from outside the document"
msgstr "зображення ззовні документа"

#: editing/messages.py:29
msgid "an image beside other content"
msgstr "зображення поряд з іншим вмістом"

#: editing/messages.py:30
msgid "a title on a link or an image"
msgstr "підказка до посилання чи зображення"

#: editing/messages.py:31
msgid "a link of a kind not allowed"
msgstr "посилання недозволеного виду"

#: editing/messages.py:32
msgid "a link with no text"
msgstr "посилання без тексту"

#: editing/messages.py:33 editing/messages.py:34
msgid "an unknown entity"
msgstr "невідома позначка"

#: editing/messages.py:35
msgid "an identifier on an entity that takes none"
msgstr "ідентифікатор на позначці, яка його не приймає"

#: editing/messages.py:36
msgid "an empty entity"
msgstr "порожня позначка"

#: editing/messages.py:37
msgid "an entity inside an entity"
msgstr "позначка всередині позначки"

#: editing/messages.py:38
msgid "a construct outside the allowed Markdown"
msgstr "конструкція поза дозволеним Markdown"

#: editing/messages.py:39
msgid "an invisible control character"
msgstr "невидимий керівний символ"

#: editing/messages.py:40
