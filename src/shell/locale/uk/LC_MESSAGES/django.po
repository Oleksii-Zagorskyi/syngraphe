#: identity/forms.py:16
msgid "Setup token"
msgstr "Токен налаштування"

#: identity/forms.py:27 identity/forms.py:70
msgid "Email address"
msgstr "Адреса електронної пошти"

#: identity/forms.py:29 identity/forms.py:86 tenancy/forms.py:20
msgid "Enter a valid email address."
msgstr "Введіть правильну адресу електронної пошти."

#: identity/forms.py:33 identity/forms.py:75
msgid "Password"
msgstr "Пароль"

#: identity/forms.py:38
msgid "Password again"
msgstr "Повторіть пароль"

#: identity/forms.py:48
msgid "This address already belongs to an account."
msgstr "Обліковий запис із цією адресою вже існує."

#: identity/forms.py:64
msgid "The two passwords differ."
msgstr "Паролі не збігаються."

#: identity/passwords.py:23
msgid "A password may contain only characters of a standard US keyboard."
msgstr ""
"Пароль може містити лише символи стандартної англійської (US) розкладки "
"клавіатури."

#: identity/passwords.py:35
msgid ""
"This password must contain an uppercase letter, a lowercase letter, a digit "
"and a special character."
msgstr ""
"Пароль має містити велику літеру, малу літеру, цифру та спеціальний символ."

#: identity/passwords.py:43
msgid ""
"An uppercase letter (A–Z), a lowercase letter (a–z), a digit (0–9) and a "
"special character; only characters of a standard US keyboard."
msgstr ""
"Велика літера (A–Z), мала літера (a–z), цифра (0–9) та спеціальний символ; "
"лише символи стандартної англійської (US) розкладки клавіатури."

#: identity/passwords.py:60
msgid "The password is too similar to the email address."
msgstr "Пароль надто схожий на адресу електронної пошти."

#: identity/templates/identity/setup.html:3
#: identity/templates/identity/setup.html:10
msgid "Set up the platform"
msgstr "Налаштування платформи"

#: identity/templates/identity/setup.html:11
msgid "The first step creates the first platform administrator."
msgstr "Перший крок створює першого адміністратора платформи."

#: identity/templates/identity/setup.html:14
msgid ""
"Printed by the install command <code>setup_token</code>; it works once, for "
"sixty minutes."
msgstr ""
"Його виводить команда встановлення <code>setup_token</code>; його можна "
"використати один раз протягом шістдесяти хвилин."

#: identity/templates/identity/setup.html:15
msgid "Continue"
msgstr "Продовжити"

#: identity/templates/identity/setup.html:17
msgid "The first platform administrator"
msgstr "Перший адміністратор платформи"

#: identity/templates/identity/setup.html:18
msgid ""
"This person administers the platform: its organisations, hosts and "
"administrators."
msgstr ""
"Ця особа керує платформою: її організаціями, хостами та адміністраторами."

#: identity/templates/identity/setup.html:25
msgid ""
"At least 10 characters, with an uppercase letter (A–Z), a lowercase letter "
"(a–z), a digit (0–9) and a special character; only characters of a standard "
"US keyboard."
msgstr ""
"Щонайменше 10 символів, серед них велика літера (A–Z), мала літера (a–z), "
"цифра (0–9) та спеціальний символ; лише символи стандартної англійської (US) "
"розкладки клавіатури."

#: identity/templates/identity/setup.html:30
msgid "Create the administrator"
msgstr "Створити адміністратора"

#: identity/templates/identity/signin.html:3
#: identity/templates/identity/signin.html:7
msgctxt "page title"
msgid "Sign in"
msgstr "Вхід"

#: identity/templates/identity/signin.html:8
msgid "The email address or password is incorrect."
msgstr "Адреса електронної пошти або пароль неправильні."

#: identity/templates/identity/signin.html:15
msgid "Sign in"
msgstr "Увійти"

#: tenancy/forms.py:16
msgid "First administrator — email address"
msgstr "Перший адміністратор — адреса електронної пошти"

#: tenancy/forms.py:19
msgid "An organisation is never created without an administrator."
msgstr "Організацію не створюють без адміністратора."

#: tenancy/forms.py:31
msgid "No registered person has this address."
msgstr "Жодна зареєстрована особа не має цієї адреси."

#: tenancy/forms.py:37 tenancy/templates/tenancy/hosts.html:8
msgid "Host"
msgstr "Хост"

#: tenancy/middleware.py:32
msgid "Unknown address."
msgstr "Невідома адреса."

#: tenancy/services.py:44 tenancy/views.py:126
msgid "Not a host name."
msgstr "Це не ім’я хоста."

#: tenancy/services.py:142
msgid "That host is already in use."
msgstr "Цей хост уже використовується."

#: tenancy/services.py:185
msgid "The platform keeps at least one host."
msgstr "У платформи має лишитися щонайменше один хост."

#: tenancy/services.py:187
msgid "Make another host the default first."
msgstr "Спершу зробіть основним інший хост."

#: tenancy/services.py:198
msgid "That host is no longer there."
msgstr "Цього хоста вже немає."

