{
  "version": 1,
  "headingMaxDepth": 4,
  "listMaxDepth": 3,
  "spans": {
    "underline": { "id": false },
    "role": { "id": true },
    "action": { "id": true },
    "term": { "id": true }
  },
  "calloutTypes": ["note", "warning", "example"],
  "quotes": true,
  "headingsTopLevelOnly": true,
  "tablesTopLevelOnly": true,
  "imageAlone": true,
  "imageSrc": "^images/[A-Za-z0-9][A-Za-z0-9._-]*$",
  "linkSchemes": "^(https?:|mailto:|(?![/\\\\]{2})[^:]*$)",
  "refusals": {
    "heading-depth": { "convert": "heading-to-max-depth" },
    "heading-nested": { "convert": "lift-after-parent" },
    "code": { "convert": "unwrap-text" },
    "inline-code": { "convert": "unwrap-text" },
    "html": { "convert": "strip-tags-keep-text" },
    "hr": { "convert": "remove" },
    "hard-break": { "convert": "space" },
    "footnote": { "convert": "footnote-inline" },
    "link-reference": { "convert": "inline-link" },
    "task-list": { "convert": "plain-list" },
    "list-depth": { "convert": "lift-to-max-depth" },
    "list-item-empty": { "convert": "remove" },
    "table-nested": { "convert": "lift-after-parent" },
    "nested-quote": { "convert": "lift-after-parent" },
    "callout-type": { "convert": "plain-quote" },
    "table-row-cells": { "convert": "drop-extra-cells" },
    "table-merged": { "convert": "none" },
    "image-src": { "convert": "drop-with-notice" },
    "image-inline": { "convert": "image-own-paragraph" },
    "title": { "convert": "drop-title" },
    "link-scheme": { "convert": "unlink-keep-text" },
    "link-empty": { "convert": "remove" },
    "span-attrs": { "convert": "unwrap-text" },
    "span-type": { "convert": "unwrap-text" },
    "span-id": { "convert": "drop-id" },
    "span-empty": { "convert": "remove" },
    "span-nested": { "convert": "unwrap-text" },
    "unsupported": { "convert": "unwrap-text" },
    "control-character": { "convert": "remove" },
    "too-large": { "convert": "none" },
    "image-missing": { "convert": "none" }
  },
  "maxBytes": 400000
}
