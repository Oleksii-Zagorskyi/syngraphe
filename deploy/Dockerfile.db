# PostgreSQL with pgBackRest, for the `db` service and the `backup` service that takes its base
# backups.
FROM postgres:16

RUN apt-get update \
    && apt-get install -y --no-install-recommends pgbackrest cron jq ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pgbackrest version | awk '{split($2, v, "."); if (v[1] < 2 || (v[1] == 2 && v[2] < 46)) exit 1}' \
    && mkdir -p /var/spool/pgbackrest /var/log/pgbackrest /run/backup \
    && chown postgres:postgres /var/spool/pgbackrest /var/log/pgbackrest

COPY deploy/pgbackrest.conf /etc/pgbackrest/pgbackrest.conf
COPY deploy/backup-env.sh deploy/backup-state.sh deploy/db-entrypoint.sh deploy/backup-entrypoint.sh /usr/local/bin/
COPY deploy/backup-cron /etc/syngraphe/backup-cron
# Set here, not with COPY --chmod, so the image builds without BuildKit too.
RUN chmod 755 /usr/local/bin/backup-env.sh /usr/local/bin/backup-state.sh \
        /usr/local/bin/db-entrypoint.sh /usr/local/bin/backup-entrypoint.sh \
    && chmod 644 /etc/pgbackrest/pgbackrest.conf /etc/syngraphe/backup-cron
