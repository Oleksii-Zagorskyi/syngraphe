# Syngraphe - configuration template.
#
# Every value the operator must supply is written as ??? and the application
# treats ??? as unset, reporting every missing key at once rather than the first.
# Copy to .env and fill in. Never commit the result.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=???
DJANGO_DEBUG=false
# The editor's conformance page, for the browser tests alone; never true in a
# running installation, and not passed to the stack.
EDITING_CONFORMANCE_PAGE=false
# true: every help page shows only its heading and "work in progress", until
# the pages' text is agreed.
HELP_WORK_IN_PROGRESS=false
# The path of the framework's own administration interface: a segment ending
# in /, such as operator/; never admin/.
DJANGO_ADMIN_PATH=???
SITE_HTTPS=true
# Proxies whose forwarded headers are trusted: addresses or CIDR networks,
# comma-separated, or none.
TRUSTED_PROXIES=???

# --- Database -------------------------------------------------------------
# Inside the stack the services reach each other by name; these addresses are
# for a process on the host, such as the test suite.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=???
POSTGRES_USER=???
POSTGRES_PASSWORD=???

# --- Redis and Celery -----------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# --- Document storage -----------------------------------------------------
# Directory holding the bare git repositories the application owns, one per
# document. Must be on a filesystem the application can fsync.
GIT_REPO_ROOT=.repos
# Directory the exports are written to and served from, each kept for a day.
# The stack sets its own; this is for a process run on the host.
EXPORT_ROOT=.exports

# --- Interface ------------------------------------------------------------
# An IANA zone name, such as Europe/Madrid; read from the first page that shows
# a date, and required from the start so an installation never runs without it.
DISPLAY_TIMEZONE=???
DEFAULT_LANGUAGE=uk

# --- Compose only ---------------------------------------------------------
# Read by Compose, never by the application.
WEB_PORT=8000
GIT_REPO_ROOT_HOST=./.repos

# --- Backup ---------------------------------------------------------------
# The off-host backup store: sftp or s3. The database's archive goes under
# <path>/database, the repositories' bundles under <path>/bundles. Fill the
# keys of the kind BACKUP_TARGET names; the other kind's are never read.
BACKUP_TARGET=???
# For sftp only.
BACKUP_SFTP_HOST=???
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USER=???
BACKUP_SFTP_PATH=???
# The store's host key as one known_hosts line.
BACKUP_SFTP_KNOWN_HOSTS=???
# For s3 only.
BACKUP_S3_ENDPOINT=???
BACKUP_S3_BUCKET=???
BACKUP_S3_REGION=???
BACKUP_S3_PATH=???
BACKUP_S3_ACCESS_KEY=???
BACKUP_S3_SECRET_KEY=???
# The encryption keys: the database archive's, the bundles'.
BACKUP_DB_CIPHER_PASS=???
BACKUP_BUNDLE_CRYPT_PASSWORD=???
BACKUP_WAL_QUEUE_MAX=10GiB
BACKUP_WAL_ALERT=2GiB
# Seconds a bundle waits for a repository's writer lock before that
# repository fails the run.
BACKUP_LOCK_TIMEOUT=30

# --- Compose only, backup -------------------------------------------------
# The host path of the store's SSH private key; /dev/null for s3.
BACKUP_KEY_FILE=
# A host:address entry for a store whose name the containers cannot resolve.
BACKUP_EXTRA_HOST=backup-store.invalid:127.0.0.1

# --- Compose only, the production override --------------------------------
# Read by deploy/compose.prod.yaml alone; the base shape reads none of them.
# Fill every ??? here: the override refuses an unset key, not a ??? one.
# The git tag deployed, which also tags the images built from it.
RELEASE_TAG=???
# The one host port the front publishes, and its certificate and key.
FRONT_PORT=???
FRONT_CERT_FILE=???
FRONT_KEY_FILE=???
# The TLS server name the front answers; _ answers any.
FRONT_SERVER_NAME=_
# The header the estate's proxy carries the client's address in.
FRONT_CLIENT_IP_HEADER=???
# The directory holding the repositories, the database and the backup state.
DATA_DIR=???
# The stack's network, as a CIDR block; the override sets web's TRUSTED_PROXIES
# to it.
STACK_SUBNET=???
# Compose reads COMPOSE_PROJECT_NAME in every shape; production sets it.
# COMPOSE_PROJECT_NAME=syngraphe
