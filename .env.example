# Syngraphe - configuration template.
#
# Every value the operator must supply is written as ??? and the application
# treats ??? as unset, reporting every missing key at once rather than the first.
# This file carries parameters only; why a value must be what it is belongs in
# the operator guide, beside the procedure that uses it.
#
# Copy to .env and fill in. Never commit the result.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=???
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=???

# --- Database -------------------------------------------------------------
POSTGRES_HOST=???
POSTGRES_PORT=5432
POSTGRES_DB=???
POSTGRES_USER=???
POSTGRES_PASSWORD=???

# --- Redis and Celery -----------------------------------------------------
REDIS_URL=???
CELERY_BROKER_URL=???

# --- Document storage -----------------------------------------------------
# Directory holding the bare git repositories the application owns, one per
# document. Must be on a filesystem the application can fsync.
GIT_REPO_ROOT=???

# --- Deployment identity --------------------------------------------------
# No deployment identity appears anywhere in the source. Everything that names
# this installation is read from here.
SITE_DISPLAY_NAME=???
SITE_BASE_URL=???
DISPLAY_TIMEZONE=Europe/Kyiv
DEFAULT_LANGUAGE=uk

# --- Outbound mail --------------------------------------------------------
EMAIL_HOST=???
EMAIL_PORT=587
EMAIL_HOST_USER=???
EMAIL_HOST_PASSWORD=???
EMAIL_FROM_ADDRESS=???
